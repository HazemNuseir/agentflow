# DME AgentFlow Environment Configuration
# Copy to .env and fill in values
# cp .env.example .env

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=DME AgentFlow
APP_ENV=production
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING
DEPLOYMENT_PROFILE=FULLY_PRIVATE_AIRGAPPED
# Options: CLOUD_SAAS | CUSTOMER_HOSTED_HYBRID | FULLY_PRIVATE_AIRGAPPED

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql+asyncpg://agentflow:<YOUR_POSTGRES_PASSWORD>@postgres:5432/agentflow
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# AI INFERENCE
# ============================================================
AI_INFERENCE_ENABLED=true
AI_MODELS_DIR=/models
AI_DEFAULT_MODEL=gemma-4-e4b-instruct-q4_k_m.gguf
AI_MAX_CONTEXT_LENGTH=8192
AI_DEFAULT_TEMPERATURE=0.7
AI_N_THREADS=4
AI_N_GPU_LAYERS=0
# Set AI_N_GPU_LAYERS=-1 for full GPU acceleration

# ============================================================
# FILE STORAGE
# ============================================================
STORAGE_BACKEND=local
# Options: local | s3
STORAGE_LOCAL_PATH=/data/uploads
# S3 (optional - leave blank for local/airgap):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=agentflow-uploads
# S3_ENDPOINT_URL=   # For MinIO or S3-compatible storage

# ============================================================
# EMAIL (Optional — leave blank to disable)
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# ============================================================
# SECURITY
# ============================================================
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# LICENSING
# ============================================================
LICENSE_KEY=
LICENSE_EDITION=STARTER
# Options: STARTER | PROFESSIONAL | ENTERPRISE_PRIVATE
OFFLINE_LICENSE_VERIFY=true

# ============================================================
# DEPLOYMENT FLAGS
# ============================================================
AIRGAP_MODE=true
ALLOW_EXTERNAL_CALLS=false
TELEMETRY_ENABLED=false
AUTO_UPDATE_ENABLED=false
ALLOW_OUTBOUND_NETWORK=false
