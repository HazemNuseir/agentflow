# ============================================================
# DME AgentFlow — GPU-accelerated inference image
# NVIDIA CUDA 12.4 + Python 3.12 + llama-cpp-python (CUDA build)
# ============================================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

LABEL maintainer="Digital Mind Engineering (DME), Jordan"
LABEL description="DME AgentFlow GPU Inference — CUDA-accelerated Gemma 4"

ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.12 and build tools
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-distutils \
    python3-pip \
    build-essential \
    cmake \
    git \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Make python3.12 the default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Upgrade pip
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

WORKDIR /app

# Install Python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install llama-cpp-python with CUDA support
ENV CMAKE_ARGS="-DGGML_CUDA=on"
RUN pip install --no-cache-dir llama-cpp-python

# Copy API source
COPY apps/api/ .
COPY models/ /models/

# Create data directories
RUN mkdir -p /data/uploads /data/documents

# Non-root user
RUN useradd -m -u 1001 agentflow && chown -R agentflow:agentflow /app /data /models
USER agentflow

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s \
    CMD curl -f http://localhost:8000/health || exit 1

# Default to full GPU layer offloading
ENV AI_N_GPU_LAYERS=-1

CMD ["python3.12", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
