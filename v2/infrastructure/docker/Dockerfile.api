FROM python:3.12-slim

LABEL maintainer="Digital Mind Engineering (DME), Jordan"
LABEL description="DME AgentFlow API — Your Business. Your Data. Your AI."

WORKDIR /app

# System deps for llama-cpp-python compilation and PDF/document processing
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    libpq-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install llama-cpp-python (CPU build by default; override CMAKE_ARGS for GPU)
ARG CMAKE_ARGS=""
RUN CMAKE_ARGS="${CMAKE_ARGS}" pip install --no-cache-dir llama-cpp-python

# Copy API source
COPY apps/api/ .

# Models directory (populated via volume mount or COPY for airgap)
RUN mkdir -p /models_v2 /data_v2/uploads /data_v2/documents

# Create data directories
RUN mkdir -p /data/uploads /data/documents

# Non-root user for security
RUN useradd -m -u 1001 agentflow && chown -R agentflow:agentflow /app /data /models_v2 /data_v2
USER agentflow

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
